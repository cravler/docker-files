
FROM ppa AS php8.5

ENV CONF_DIR_PHP_CLI=/etc/php/8.5/cli

RUN \
\
# All our dependencies, in alphabetical order (to ease maintenance)
    apt-get update && apt-get install -y --no-install-recommends \
        php8.5-apcu \
        php8.5-imagick \
        php8.5-memcached \
        php8.5-bcmath \
        php8.5-cli \
        php8.5-curl \
        php8.5-gd \
        php8.5-intl \
        php8.5-ldap \
        php8.5-mbstring \
        php8.5-mysql \
        php8.5-pgsql \
        php8.5-sqlite3 \
        php8.5-xml \
        php8.5-zip && \
\
# Remove cache
    apt-get clean && rm -rf /var/lib/apt/lists/*

########################################################################################################################
